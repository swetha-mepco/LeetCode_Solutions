//N Queens
import java.util.ArrayList;
import java.util.List;

public class Solution {

    public List<List<String>> solveNQueens(int n) {
        List<List<String>> result = new ArrayList<>();
        backtrack(n, 0, new int[n], result);  // Start backtracking with the first row
        return result;
    }
    
    // Backtracking function to place queens row by row
    private void backtrack(int n, int row, int[] cols, List<List<String>> result) {
        if (row == n) {
            // If all queens are placed, generate the board configuration
            result.add(generateBoard(cols, n));
            return;
        }
        
        for (int col = 0; col < n; col++) {
            // Check if placing a queen at (row, col) is safe
            if (isSafe(row, col, cols)) {
                // Place the queen
                cols[row] = col;
                
                // Recur to place queens in the next row
                backtrack(n, row + 1, cols, result);
                
                // Backtrack (remove the queen)
                cols[row] = -1;
            }
        }
    }

    // Helper function to check if it's safe to place a queen at (row, col)
    private boolean isSafe(int row, int col, int[] cols) {
        for (int i = 0; i < row; i++) {
            // Check column conflict or diagonal conflict
            if (cols[i] == col || Math.abs(cols[i] - col) == Math.abs(i - row)) {
                return false;
            }
        }
        return true;
    }

    // Helper function to generate the board configuration from column placements
    private List<String> generateBoard(int[] cols, int n) {
        List<String> board = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            char[] row = new char[n];
            for (int j = 0; j < n; j++) {
                row[j] = (cols[i] == j) ? 'Q' : '.';
            }
            board.add(new String(row));
        }
        return board;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();

        // Test case 1: n = 4
        int n1 = 4;
        List<List<String>> result1 = solution.solveNQueens(n1);
        System.out.println("Solutions for n = 4:");
        for (List<String> board : result1) {
            for (String row : board) {
                System.out.println(row);
            }
            System.out.println();
        }

        // Test case 2: n = 1
        int n2 = 1;
        List<List<String>> result2 = solution.solveNQueens(n2);
        System.out.println("Solutions for n = 1:");
        for (List<String> board : result2) {
            for (String row : board) {
                System.out.println(row);
            }
            System.out.println();
        }
    }
}
