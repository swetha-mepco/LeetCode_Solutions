//Prime Palindrome
class Solution {
    public int primePalindrome(int n) {
        if (n <= 2) return 2;
        if (n <= 3) return 3;
        if (n <= 5) return 5;
        if (n <= 7) return 7;
        if (n <= 11) return 11;

        // Generate odd-length palindromes
        for (int len = 1; len < 6; len++) { // length of half the palindrome
            for (int root = (int)Math.pow(10, len - 1); root < Math.pow(10, len); root++) {
                String s = Integer.toString(root);
                StringBuilder sb = new StringBuilder(s);
                // make odd-length palindrome by appending reverse of all but last digit
                sb.reverse();
                String palStr = s + sb.substring(1);
                int pal = Integer.parseInt(palStr);
                if (pal >= n && isPrime(pal)) return pal;
            }
        }
        return -1; // should never happen per constraints
    }

    private boolean isPrime(int x) {
        if (x < 2) return false;
        if (x % 2 == 0) return x == 2;
        int sqrt = (int)Math.sqrt(x);
        for (int i = 3; i <= sqrt; i += 2) {
            if (x % i == 0) return false;
        }
        return true;
    }
}
