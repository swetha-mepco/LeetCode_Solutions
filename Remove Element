//Remove Element
class Solution {
    public int removeElement(int[] nums, int val) {
        int k = 0; // Pointer for the position of valid elements

        for (int i = 0; i < nums.length; i++) {
            // If the current element is not equal to val
            if (nums[i] != val) {
                nums[k] = nums[i]; // Copy it to the position k
                k++; // Increment the position for the next valid element
            }
        }

        return k; // Return the count of valid elements
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        
        // Example 1
        int[] nums1 = {3, 2, 2, 3};
        int val1 = 3;
        int k1 = solution.removeElement(nums1, val1);
        System.out.println("Unique count: " + k1); // Output: 2
        System.out.print("Elements: ");
        for (int i = 0; i < k1; i++) {
            System.out.print(nums1[i] + " "); // Output: 2 2
        }
        
        System.out.println();

        // Example 2
        int[] nums2 = {0, 1, 2, 2, 3, 0, 4, 2};
        int val2 = 2;
        int k2 = solution.removeElement(nums2, val2);
        System.out.println("Unique count: " + k2); // Output: 5
        System.out.print("Elements: ");
        for (int i = 0; i < k2; i++) {
            System.out.print(nums2[i] + " "); // Output: 0 1 3 0 4
        }
    }
}
