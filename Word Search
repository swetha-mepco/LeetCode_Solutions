//Word Search
public class Solution {
    public boolean exist(char[][] board, String word) {
        int m = board.length;
        int n = board[0].length;
        
        // Try to find the word starting from each cell
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Start backtracking from the cell (i, j)
                if (backtrack(board, word, i, j, 0)) {
                    return true;
                }
            }
        }
        
        return false;
    }
    
    // Backtracking function
    private boolean backtrack(char[][] board, String word, int i, int j, int index) {
        // If index equals word length, we've found the entire word
        if (index == word.length()) {
            return true;
        }
        
        // Check boundaries and if the current character matches the word[index]
        if (i < 0 || i >= board.length || j < 0 || j >= board[0].length || board[i][j] != word.charAt(index)) {
            return false;
        }
        
        // Save the current cell's character and mark the cell as visited by changing its value
        char temp = board[i][j];
        board[i][j] = '#';  // Mark the cell as visited
        
        // Explore in all 4 directions: up, down, left, right
        boolean found = backtrack(board, word, i + 1, j, index + 1) ||  // down
                        backtrack(board, word, i - 1, j, index + 1) ||  // up
                        backtrack(board, word, i, j + 1, index + 1) ||  // right
                        backtrack(board, word, i, j - 1, index + 1);    // left
        
        // Restore the cell's character
        board[i][j] = temp;
        
        return found;
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        
        // Test case 1
        char[][] board1 = {
            {'A', 'B', 'C', 'E'},
            {'S', 'F', 'C', 'S'},
            {'A', 'D', 'E', 'E'}
        };
        String word1 = "ABCCED";
        System.out.println(solution.exist(board1, word1));  // Output: true

        // Test case 2
        String word2 = "SEE";
        System.out.println(solution.exist(board1, word2));  // Output: true

        // Test case 3
        String word3 = "ABCB";
        System.out.println(solution.exist(board1, word3));  // Output: false
    }
}
