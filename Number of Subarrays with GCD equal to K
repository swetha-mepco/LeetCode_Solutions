//Number of Subarrays with GCD equal to K
class Solution {
    public int subarrayGCD(int[] nums, int k) {
        int n = nums.length;
        int count = 0;

        for (int i = 0; i < n; i++) {
            int gcdVal = 0;

            for (int j = i; j < n; j++) {
                // If not divisible by k, break early
                if (nums[j] % k != 0) break;

                gcdVal = gcd(gcdVal, nums[j]);

                if (gcdVal == k) {
                    count++;
                }
            }
        }

        return count;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
