// Sqrt(x)
class Solution {
    public int mySqrt(int x) {
        // Handle special cases
        if (x < 0) return 0; // Not applicable for negative numbers
        if (x == 0 || x == 1) return x; // The square root of 0 is 0, and of 1 is 1

        long low = 1, high = x / 2 + 1; // Set initial bounds for binary search

        while (low < high) {
            long mid = low + (high - low) / 2; // Calculate mid point
            if (mid * mid > x) {
                high = mid; // Move the high pointer down
            } else {
                low = mid + 1; // Move the low pointer up
            }
        }

        return (int)low - 1; // Return the largest integer whose square is less than or equal to x
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        
        // Example test cases
        System.out.println(solution.mySqrt(4));  // Output: 2
        System.out.println(solution.mySqrt(8));  // Output: 2
        System.out.println(solution.mySqrt(0));  // Output: 0
        System.out.println(solution.mySqrt(1));  // Output: 1
        System.out.println(solution.mySqrt(16)); // Output: 4
    }
}
