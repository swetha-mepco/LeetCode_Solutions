//Combinations
import java.util.*;

public class Solution {
    public List<List<Integer>> combine(int n, int k) {
        List<List<Integer>> result = new ArrayList<>();
        backtrack(n, k, 1, new ArrayList<>(), result);
        return result;
    }
    
    // Backtracking helper function
    private void backtrack(int n, int k, int start, List<Integer> current, List<List<Integer>> result) {
        // If the current combination size is k, add it to the result
        if (current.size() == k) {
            result.add(new ArrayList<>(current));  // Add a copy of the current combination
            return;
        }
        
        // Try each number from `start` to `n`
        for (int i = start; i <= n; i++) {
            current.add(i);  // Add current number to the combination
            backtrack(n, k, i + 1, current, result);  // Recurse for the next number
            current.remove(current.size() - 1);  // Backtrack: remove the last number
        }
    }

    public static void main(String[] args) {
        Solution solution = new Solution();
        
        // Test case 1: n = 4, k = 2
        int n1 = 4, k1 = 2;
        System.out.println(solution.combine(n1, k1));  // Output: [[1, 2], [1, 3], [1, 4], [2, 3], [2, 4], [3, 4]]

        // Test case 2: n = 1, k = 1
        int n2 = 1, k2 = 1;
        System.out.println(solution.combine(n2, k2));  // Output: [[1]]
    }
}
