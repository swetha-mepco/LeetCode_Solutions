//Binary Search Tree Iterator
import java.util.*;

class BSTIterator {
    private Stack<TreeNode> stack = new Stack<>();

    public BSTIterator(TreeNode root) {
        pushLeft(root);
    }

    // Push all left nodes
    private void pushLeft(TreeNode node) {
        while (node != null) {
            stack.push(node);
            node = node.left;
        }
    }

    public int next() {
        TreeNode node = stack.pop();
        
        // If right exists, process its left chain
        if (node.right != null) {
            pushLeft(node.right);
        }
        
        return node.val;
    }

    public boolean hasNext() {
        return !stack.isEmpty();
    }
}
