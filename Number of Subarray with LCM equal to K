//Number of Subarrays with LCM equal to K
class Solution {
    public int subarrayLCM(int[] nums, int k) {
        int n = nums.length;
        int count = 0;

        for (int i = 0; i < n; i++) {
            int lcmVal = 1;

            for (int j = i; j < n; j++) {
                // If nums[j] cannot contribute to k, stop
                if (k % nums[j] != 0) break;

                lcmVal = lcm(lcmVal, nums[j]);

                if (lcmVal == k) {
                    count++;
                }

                // If exceeded k, stop
                if (lcmVal > k) break;
            }
        }

        return count;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }

    private int lcm(int a, int b) {
        return a / gcd(a, b) * b;
    }
}
