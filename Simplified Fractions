//Simplified Fractions
import java.util.*;

class Solution {
    public List<String> simplifiedFractions(int n) {
        List<String> result = new ArrayList<>();
        for (int d = 2; d <= n; d++) {
            for (int num = 1; num < d; num++) {
                if (gcd(num, d) == 1) {
                    result.add(num + "/" + d);
                }
            }
        }
        return result;
    }

    private int gcd(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
